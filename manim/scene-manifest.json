    "limit": "local-derivative",
    "curvature": "local-derivative",
    "series": "taylor-approximation",
    "local-map": "local-derivative",
    "vectors": "vector-span",
    "span": "vector-span",
    "transform": "linear-transform",
    "composition": "linear-transform",
    "transform3d": "linear-transform",
    "area": "linear-transform",
    "subspaces": "subspace-collapse",
    "dimensions": "linear-transform",
    "projection": "projection-geometry",
    "cross": "projection-geometry",
    "duality3d": "projection-geometry",
    "cramer": "projection-geometry",
    "basis": "linear-transform",
    "eigen": "eigen-directions",
    "abstract": "vector-span",
    "field": "differential-flow",
    "pde": "differential-modes",
    "heat": "differential-modes",
    "fourier": "fourier-epicycles",
    "complex": "fourier-epicycles",
    "laplace": "fourier-epicycles",
    "matrix-exp": "differential-flow",
    "network": "neural-signals",
    "landscape": "gradient-descent",
    "backprop": "neural-signals",
    "tokens": "transformer-flow",
