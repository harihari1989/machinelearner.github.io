{
  "version": 1,
  "engine": {
    "name": "ManimGL",
    "repository": "https://github.com/3b1b/manim",
    "commit": "e61ad5c3f9c9ac96cba7a46dffc665c0ec13beea",
    "license": "MIT"
  },
  "assetBase": "assets/manim",
  "assets": {
    "integral-accumulator": { "class": "IntegralAccumulator", "title": "Accumulation becomes area", "scenes": ["accumulation"] },
    "local-derivative": { "class": "LocalDerivative", "title": "A derivative is a local prediction", "scenes": ["tangent", "geometry", "limit", "curvature", "local-map"] },
    "chain-rule-flow": { "class": "ChainRuleFlow", "title": "The chain rule passes influence", "scenes": ["chain"] },
    "exponential-growth": { "class": "ExponentialGrowth", "title": "Exponential growth reproduces itself", "scenes": ["growth"] },
    "constraint-motion": { "class": "ConstraintMotion", "title": "A constraint couples every change", "scenes": ["constraint"] },
    "taylor-approximation": { "class": "TaylorApproximation", "title": "Taylor terms widen local agreement", "scenes": ["series"] },
    "vector-span": { "class": "VectorSpan", "title": "Vectors are scaled directions", "scenes": ["vectors", "span", "abstract"] },
    "linear-transform": { "class": "LinearTransform", "title": "A matrix moves the basis", "scenes": ["transform", "composition", "transform3d", "area", "dimensions", "basis"] },
    "projection-geometry": { "class": "ProjectionGeometry", "title": "Projection measures alignment", "scenes": ["projection", "cross", "duality3d", "cramer"] },
    "subspace-collapse": { "class": "SubspaceCollapse", "title": "Rank reveals what survives", "scenes": ["subspaces"] },
    "eigen-directions": { "class": "EigenDirections", "title": "Eigen-directions do not turn", "scenes": ["eigen"] },
    "differential-flow": { "class": "DifferentialFlow", "title": "A differential equation is a velocity field", "scenes": ["field", "matrix-exp"] },
    "differential-modes": { "class": "DifferentialModes", "title": "Diffusion removes fine detail first", "scenes": ["pde", "heat"] },
    "fourier-epicycles": { "class": "FourierEpicycles", "title": "Frequencies add as rotating vectors", "scenes": ["fourier", "complex", "laplace"] },
    "neural-signals": { "class": "NeuralSignals", "title": "A neural network composes transformations", "scenes": ["network", "backprop"] },
    "gradient-descent": { "class": "GradientDescent", "title": "Gradient descent follows local steepness", "scenes": ["landscape"] },
    "transformer-flow": { "class": "TransformerFlow", "title": "Transformers edit a residual stream", "scenes": ["tokens", "transformer", "memory"] },
    "attention-routing": { "class": "AttentionRouting", "title": "Attention is content-dependent routing", "scenes": ["attention"] },
    "diffusion-denoising": { "class": "DiffusionDenoising", "title": "Diffusion generates through local denoising", "scenes": ["diffusion"] }
  },
  "scenes": {
    "accumulation": "integral-accumulator",
    "tangent": "local-derivative",
    "geometry": "local-derivative",
    "chain": "chain-rule-flow",
    "growth": "exponential-growth",
